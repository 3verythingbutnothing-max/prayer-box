{
  "name": "prayer-box-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/prayer-box/",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/care.test.ts src/story.test.ts src/organization.test.ts src/qr.test.ts src/feedback-cues.test.ts src/widgets.test.ts src/donation-amount.test.ts",
    "test:stress": "node --experimental-strip-types scripts/stress-domain.ts && node --experimental-strip-types scripts/audit-invariants.ts"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
