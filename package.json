{
  "name": "prayer-box-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=/prayer-box/",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --experimental-strip-types --test src/domain.test.ts src/care.test.ts src/story.test.ts src/organization.test.ts src/qr.test.ts src/feedback-cues.test.ts src/widgets.test.ts src/donation-amount.test.ts src/story-replies.test.ts src/funding-window.test.ts src/recipients.test.ts src/request-edits.test.ts src/prayer-groups.test.ts src/picture-preview.test.ts src/group-moderation.test.ts src/prayer-events.test.ts src/event-calendar.test.ts",
    "test:stress": "node --experimental-strip-types scripts/stress-domain.ts && node --experimental-strip-types scripts/audit-invariants.ts",
    "backend:types": "wrangler types --config backend/wrangler.jsonc backend/worker-configuration.d.ts",
    "backend:check": "tsc --project backend/tsconfig.json --noEmit",
    "backend:test": "vitest run --config backend/tests/vitest.config.ts",
    "backend:migrate": "wrangler d1 migrations apply DB --local --config backend/wrangler.jsonc",
    "backend:seed": "node scripts/seed-backend.mjs",
    "backend:build": "tsc --noEmit && vite build --mode backend --outDir dist-backend",
    "backend:dev": "wrangler dev --local --config backend/wrangler.jsonc",
    "backend:dry-run": "wrangler deploy --dry-run --config backend/wrangler.jsonc --outdir output/backend-build",
    "backend:test:check": "tsc --project backend/tests/tsconfig.json --noEmit",
    "backend:policy": "node --experimental-strip-types --test backend/tests/policy.test.ts"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.154.0"
  }
}
